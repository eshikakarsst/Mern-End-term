{
  "info": {
    "name": "ShopKart Lab 04 - Wishlist",
    "_postman_id": "shopkart-lab04-wishlist",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "productId",
      "value": "REPLACE_WITH_PRODUCT_ID"
    }
  ],
  "item": [
    {
      "name": "Add product to wishlist",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/wishlist/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "wishlist",
            "{{productId}}"
          ]
        }
      }
    },
    {
      "name": "Duplicate add - expect 409",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/wishlist/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "wishlist",
            "{{productId}}"
          ]
        }
      }
    },
    {
      "name": "Get current wishlist",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/wishlist",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "wishlist"
          ]
        }
      }
    },
    {
      "name": "Remove product from wishlist",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/wishlist/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "wishlist",
            "{{productId}}"
          ]
        }
      }
    }
  ]
}